---
const year = new Date().getFullYear();
const links = [
  { label: "About", href: "#about" },
  { label: "Treatments", href: "#treatments" },
  { label: "Our Team", href: "#team" },
  { label: "Nidhi Paediatrics", href: "#nidhi" },
  { label: "Patient Stories", href: "#stories" },
  { label: "Book Consultation", href: "#contact" },
];
const socials = [
  { label: "YouTube", href: "#", d: "M22.54 6.42a2.78 2.78 0 0 0-1.95-2C18.88 4 12 4 12 4s-6.88 0-8.59.42a2.78 2.78 0 0 0-1.95 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.41 19c1.71.42 8.59.42 8.59.42s6.88 0 8.59-.42a2.78 2.78 0 0 0 1.95-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33ZM9.75 15.02v-6.5l5.75 3.25-5.75 3.25Z" },
  { label: "Facebook", href: "#", d: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z" },
  { label: "Instagram", href: "#", d: "M16 3H8a5 5 0 0 0-5 5v8a5 5 0 0 0 5 5h8a5 5 0 0 0 5-5V8a5 5 0 0 0-5-5Zm-4 5.5A3.5 3.5 0 1 1 8.5 12 3.5 3.5 0 0 1 12 8.5Zm4.8-.3a.9.9 0 1 1-.9-.9.9.9 0 0 1 .9.9Z" },
];
---

<footer id="footer" class="footer">
  <div class="footer-deco" aria-hidden="true"></div>
  <div class="wrap wrap-wide footer-grid">
    <div class="footer-brand">
      <img src="/images/logo.png" alt="Pretheeksha Fertility Centre" width="190" height="62" />
      <p>Your trusted partner for complete fertility and paediatric care — expert guidance, advanced technology, and compassionate support at every step of your journey.</p>
      <div class="socials">
        {socials.map((s) => (
          <a href={s.href} aria-label={s.label} class="social">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={s.d} /></svg>
          </a>
        ))}
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h4>Visit &amp; Connect</h4>
      <ul class="contact-list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Meenad, Kollam, Kerala — 691573</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          <a href="tel:+918330084300">+91 83300 84300</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          <a href="mailto:klmclinic@pretheeksha.com">klmclinic@pretheeksha.com</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap wrap-wide footer-base">
    <p>© {year} Pretheeksha Fertility Centre. All rights reserved.</p>
    <p>Crafted with care for every family.</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--forest);
    color: rgba(247, 242, 232, 0.78);
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
    margin-top: 2rem;
    overflow: hidden;
  }
  .footer-deco {
    position: absolute;
    inset: auto -10% -40% auto;
    width: 460px; height: 460px;
    background: radial-gradient(circle, rgba(195,148,51,0.22), transparent 70%);
    pointer-events: none;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 4rem);
    position: relative;
    z-index: 1;
  }
  .footer-brand img { height: 56px; width: auto; margin-bottom: 1.3rem; filter: brightness(1.6) saturate(1.1); }
  .footer-brand p { max-width: 38ch; line-height: 1.7; }
  .socials { display: flex; gap: 0.7rem; margin-top: 1.6rem; }
  .social {
    display: grid; place-items: center;
    width: 42px; height: 42px;
    border-radius: 50%;
    background: rgba(247, 242, 232, 0.08);
    color: var(--honey-soft);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease), color 0.3s var(--ease);
  }
  .social svg { width: 18px; height: 18px; }
  .social:hover { background: var(--honey); color: var(--forest); transform: translateY(-3px); }

  .footer-col h4 {
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--honey-soft);
    margin-bottom: 1.3rem;
    font-weight: 600;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.85rem; }
  .footer-col a { transition: color 0.25s var(--ease); }
  .footer-col a:hover { color: #fff; }
  .contact-list li { display: flex; align-items: flex-start; gap: 0.7rem; line-height: 1.5; }
  .contact-list svg { width: 18px; height: 18px; color: var(--honey-soft); flex-shrink: 0; margin-top: 2px; }

  .footer-base {
    position: relative; z-index: 1;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.5rem;
    border-top: 1px solid rgba(247, 242, 232, 0.12);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.85rem;
    color: rgba(247, 242, 232, 0.55);
  }

  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-base { flex-direction: column; text-align: center; }
  }
</style>
