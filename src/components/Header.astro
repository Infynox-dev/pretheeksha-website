---
import { getPublicEnv } from "../lib/env.ts";
import { bookingUrl, extractAttribution } from "../lib/booking.ts";

interface Props {
  bookHref?: string;
  nav?: Array<{ label: string; href: string }>;
}

const {
  bookHref: bookHrefProp,
  nav: navProp,
} = Astro.props as Props;

const env = getPublicEnv();
const showBugReports = env.PUBLIC_ENABLE_BUG_REPORTS;
const attribution = extractAttribution(Astro.url.searchParams);
const bookHref =
  bookHrefProp || bookingUrl(env.PUBLIC_BOOKING_APP_URL, attribution);

const nav = navProp ?? [
  { label: "About", href: "/#about" },
  { label: "Treatments", href: "/#treatments" },
  { label: "Our Team", href: "/#team" },
  { label: "Nidhi", href: "/#nidhi" },
  { label: "Stories", href: "/#stories" },
];
---

<header id="site-header" class="site-header">
  <div class="topbar">
    <div class="wrap wrap-wide topbar-inner">
      {showBugReports && (
      <div class="bug-menu-wrap">
        <button type="button" class="bug-report-btn bug-report-btn-topbar" data-bug-menu-toggle aria-label="Bug reports">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
          <span class="bug-btn-label">Report Bug</span>
        </button>
        <div class="bug-menu" data-bug-menu hidden>
          <button type="button" data-bug-open="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/></svg>
            Report a bug
          </button>
          <button type="button" data-bug-open="list">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
            My bug reports
          </button>
        </div>
      </div>
      )}
      <a href="tel:+918330084300" class="topbar-item topbar-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
        <span class="topbar-phone-text">+91&nbsp;83300&nbsp;84300</span>
      </a>
      <a href="mailto:klmclinic@pretheeksha.com" class="topbar-item topbar-mail">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        klmclinic@pretheeksha.com
      </a>
      <span class="topbar-item topbar-loc">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Meenad, Kollam, Kerala
      </span>
    </div>
  </div>

  <div class="nav-bar">
    <div class="wrap wrap-wide nav-inner">
      <a href="#top" class="brand" aria-label="Pretheeksha Fertility Centre — home">
        <img src="/images/logo.png" alt="Pretheeksha Fertility Centre" width="167" height="48" />
      </a>

      <nav class="primary-nav-desktop" aria-label="Primary">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="nav-end">
        {showBugReports && (
        <div class="bug-menu-wrap bug-menu-wrap-nav">
          <button type="button" class="bug-report-btn" data-bug-menu-toggle aria-label="Bug reports">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
            <span class="bug-btn-label">Report Bug</span>
          </button>
          <div class="bug-menu" data-bug-menu hidden>
            <button type="button" data-bug-open="submit">Report a bug</button>
            <button type="button" data-bug-open="list">My bug reports</button>
          </div>
        </div>
        )}
        <a href={bookHref} class="btn btn-primary nav-cta">Book Consultation</a>
        <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-controls="primary-nav" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Drawer lives outside sticky header so position:fixed is always viewport-relative -->
<div id="nav-backdrop" class="nav-backdrop" hidden></div>
<nav id="primary-nav" class="primary-nav-drawer" aria-label="Primary" hidden>
  <ul>
    {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
  </ul>
  {showBugReports && (
  <button type="button" class="bug-report-btn nav-cta-mobile" data-bug-open="submit">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/></svg>
    Report a bug
  </button>
  )}
  <a href={bookHref} class="btn btn-gold nav-cta-mobile">Book Consultation</a>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow 0.4s var(--ease);
  }
  .topbar {
    background: var(--forest);
    color: rgba(247, 242, 232, 0.85);
    font-size: 0.82rem;
    max-height: 42px;
    overflow: hidden;
    transition: max-height 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .topbar-inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: flex-end;
    height: 42px;
  }
  .bug-menu-wrap-nav { display: none; }
  .topbar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.25s var(--ease);
  }
  .topbar-item svg { width: 15px; height: 15px; color: var(--honey-soft); }
  .topbar-item:hover { color: #fff; }

  .nav-bar {
    position: relative;
    background: rgba(251, 248, 241, 0.92);
    border-bottom: 1px solid rgba(31, 58, 44, 0.07);
    transition: background 0.4s var(--ease);
  }
  .nav-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .nav-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 84px;
    transition: height 0.4s var(--ease);
  }
  .site-header.is-scrolled .nav-inner { height: 70px; }
  .site-header.is-scrolled .nav-bar { background: rgba(251, 248, 241, 0.96); }
  .site-header.is-scrolled { box-shadow: 0 12px 40px -28px rgba(31, 58, 44, 0.5); }
  .site-header.is-scrolled .topbar { max-height: 0; opacity: 0; }

  .brand img { height: 48px; width: auto; transition: height 0.4s var(--ease); }
  .site-header.is-scrolled .brand img { height: 42px; }

  .primary-nav-desktop ul {
    display: flex;
    gap: 2.1rem;
    align-items: center;
  }
  .primary-nav-desktop a {
    font-weight: 500;
    font-size: 0.97rem;
    color: var(--ink-soft);
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.25s var(--ease);
  }
  .primary-nav-desktop a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 0; height: 2px;
    background: var(--honey);
    border-radius: 2px;
    transition: width 0.3s var(--ease);
  }
  .primary-nav-desktop a:hover { color: var(--forest); }
  .primary-nav-desktop a:hover::after { width: 100%; }

  .nav-end { display: flex; align-items: center; gap: 0.9rem; }
  @media (min-width: 921px) {
    .topbar .bug-menu-wrap { display: none; }
    .bug-menu-wrap-nav { display: block; }
    .primary-nav-drawer,
    .nav-backdrop { display: none !important; }
  }

  .nav-toggle { display: none; width: 44px; height: 44px; flex-direction: column; justify-content: center; gap: 5px; }
  .nav-toggle span {
    display: block; height: 2px; width: 24px; margin-inline: auto;
    background: var(--forest); border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 190;
    background: rgba(31, 58, 44, 0.35);
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .nav-backdrop[hidden] { display: none; }

  .primary-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    width: min(82vw, 340px);
    max-width: 100%;
    overflow-y: auto;
    background: var(--shell);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
    padding: 6rem 2rem 2rem;
    box-shadow: -30px 0 80px -40px rgba(31, 58, 44, 0.6);
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.45s var(--ease), visibility 0.45s var(--ease);
  }
  .primary-nav-drawer[hidden] { display: flex; }
  .primary-nav-drawer.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }
  .primary-nav-drawer ul {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    width: 100%;
  }
  .primary-nav-drawer li { border-bottom: 1px solid rgba(31, 58, 44, 0.08); }
  .primary-nav-drawer a {
    display: block;
    padding: 1rem 0;
    font-size: 1.15rem;
    font-family: var(--font-display);
    color: var(--forest);
    font-weight: 500;
  }
  .nav-cta-mobile {
    display: inline-flex;
    margin-top: 1.6rem;
    width: 100%;
    max-width: 100%;
    justify-content: center;
    align-self: stretch;
    box-sizing: border-box;
  }

  .topbar-phone { white-space: nowrap; flex-shrink: 0; }
  .topbar-phone-text { white-space: nowrap; }

  @media (max-width: 920px) {
    .topbar { font-size: 0.75rem; max-height: 38px; }
    .topbar-inner {
      justify-content: space-between;
      gap: 0.65rem;
      height: 38px;
    }
    .topbar-loc,
    .topbar-mail { display: none; }
    .topbar-phone { margin-left: auto; }
    .bug-report-btn-topbar .bug-btn-label { display: none; }
    .nav-cta { display: none; }
    .bug-menu-wrap-nav { display: none; }
    .primary-nav-desktop { display: none; }
    .nav-toggle { display: flex; }

    :global(body.nav-open) .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    :global(body.nav-open) .nav-toggle span:nth-child(2) { opacity: 0; }
    :global(body.nav-open) .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    :global(body.nav-open) { overflow: hidden; }
  }

  @media (max-width: 380px) {
    .topbar-phone-text { font-size: 0.72rem; letter-spacing: -0.01em; }
  }
</style>
