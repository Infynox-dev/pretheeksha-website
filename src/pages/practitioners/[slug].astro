---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LeadForm from "../../components/LeadForm.astro";
import { loadContentBundle, type Practitioner } from "../../lib/api/content.ts";
import { getPublicEnv } from "../../lib/env.ts";
import { legacyDoctorPathFor } from "../../lib/practitioners.ts";
import {
  bookingDeepLinkForSlug,
  bookingLoginUrl,
  extractAttribution,
} from "../../lib/booking.ts";

export async function getStaticPaths() {
  const bundle = await loadContentBundle({
    routes: ["/practitioners"],
  });
  // Skip clinic doctors with rich /dr-* pages — astro.config redirects own those slugs.
  // Generating a static page here would win over the redirect and serve a thin shell.
  return bundle.practitioners
    .filter((p) => !legacyDoctorPathFor(p.slug, p.public_display_name))
    .map((p) => ({
      params: { slug: p.slug },
      props: {
        practitioner: p,
        services: bundle.services,
      },
    }));
}

interface RouteProps {
  practitioner: Practitioner;
  services: Awaited<ReturnType<typeof loadContentBundle>>["services"];
}

const { practitioner, services } = Astro.props as RouteProps;

// Prefer rich static profiles over the thin CMS shell for the clinic doctors.
const legacyPath = legacyDoctorPathFor(
  practitioner.slug,
  practitioner.public_display_name,
);
if (legacyPath) {
  return Astro.redirect(legacyPath, 301);
}

const env = getPublicEnv();
const attribution = {
  ...extractAttribution(Astro.url.searchParams),
  utm_source: "landing",
  utm_medium: "practitioner",
  utm_campaign: practitioner.slug,
};
const bookCta = bookingLoginUrl(
  env.PUBLIC_BOOKING_APP_URL,
  bookingDeepLinkForSlug(practitioner.slug),
  attribution,
);

const seoTitle =
  practitioner.seo_title ||
  `${practitioner.public_display_name} — Pretheeksha Fertility Centre`;
const seoDescription =
  practitioner.seo_description ||
  practitioner.bio?.slice(0, 200) ||
  `Consult ${practitioner.public_display_name} at Pretheeksha Fertility Centre.`;
---

<Base title={seoTitle} description={seoDescription}>
  <a id="top"></a>
  <Header />
  <main>
    <section class="practitioner-hero">
      <div class="wrap wrap-wide practitioner-grid">
        <div class="practitioner-photo">
          {practitioner.photo_url ? (
            <img
              src={practitioner.photo_url}
              alt={practitioner.public_display_name}
              loading="eager"
            />
          ) : (
            <div class="practitioner-photo-placeholder" aria-hidden="true">
              <span>{practitioner.public_display_name.charAt(0)}</span>
            </div>
          )}
        </div>
        <div class="practitioner-copy">
          <span class="eyebrow">Our Team</span>
          <h1>{practitioner.public_display_name}</h1>
          {practitioner.public_credentials && (
            <p class="practitioner-creds">{practitioner.public_credentials}</p>
          )}
          {practitioner.bio && (
            <p class="practitioner-bio">{practitioner.bio}</p>
          )}
          <a href={bookCta} class="btn btn-primary">Book Consultation</a>
        </div>
      </div>
    </section>

    {services.length > 0 && (
      <section class="section">
        <div class="wrap wrap-wide">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Care</span>
            <h2>Related services</h2>
          </div>
          <ul class="service-list">
            {services.slice(0, 6).map((s) => (
              <li>
                <strong>{s.public_name}</strong>
                {s.summary && <p>{s.summary}</p>}
              </li>
            ))}
          </ul>
          <div class="lead-wrap">
            <LeadForm />
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .practitioner-hero {
    padding: clamp(3rem, 8vw, 5.5rem) 0;
    background: linear-gradient(180deg, var(--shell) 0%, rgba(232, 240, 234, 0.45) 100%);
  }
  .practitioner-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .practitioner-photo img {
    width: 100%;
    max-width: 420px;
    border-radius: var(--radius-lg, 1.25rem);
    object-fit: cover;
    box-shadow: var(--shadow);
  }
  .practitioner-photo-placeholder {
    width: min(100%, 320px);
    aspect-ratio: 4/5;
    border-radius: var(--radius-lg, 1.25rem);
    background: var(--sage-tint, #e8f0ea);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--forest);
  }
  .practitioner-copy h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.4rem 0 0.6rem;
  }
  .practitioner-creds {
    color: var(--moss);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .practitioner-bio {
    color: var(--text-soft);
    margin-bottom: 1.5rem;
    max-width: 36rem;
    line-height: 1.6;
  }
  .service-list {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }
  .service-list li {
    padding: 1rem 1.25rem;
    background: var(--surface, #fff);
    border: 1px solid rgba(31, 58, 44, 0.08);
    border-radius: var(--radius, 0.75rem);
  }
  .service-list p {
    margin: 0.35rem 0 0;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .practitioner-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
