# Pretheeksha landing (Astro) — environment URLs
# Pick ONE block. Local ports are fixed and do not change between restarts.
#
# | Role    | Local                         | Staging                                      | Production                          |
# |---------|-------------------------------|----------------------------------------------|-------------------------------------|
# | API     | http://127.0.0.1:8000/api/v1  | https://staging-api.pretheeksha.com/api/v1   | https://api.pretheeksha.com/api/v1  |
# | Landing | http://127.0.0.1:4321/        | https://staging.pretheeksha.com/             | https://pretheeksha.com/            |
# | Booking | http://localhost:3000/        | https://staging-booking.pretheeksha.com/     | https://booking.pretheeksha.com/    |

# ── Local (default for laptop `npm run dev`) ─────────────────────
API_BASE_URL=http://127.0.0.1:8000/api/v1
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
PUBLIC_BOOKING_APP_URL=http://localhost:3000/
SITE_URL=http://127.0.0.1:4321

# ── Coolify staging (build-time) — uncomment / set in Coolify UI ─
# SITE_URL=https://staging.pretheeksha.com
# API_BASE_URL=https://staging-api.pretheeksha.com/api/v1
# PUBLIC_API_BASE_URL=https://staging-api.pretheeksha.com/api/v1
# PUBLIC_BOOKING_APP_URL=https://staging-booking.pretheeksha.com/

# ── Coolify production (build-time) ──────────────────────────────
# SITE_URL=https://pretheeksha.com
# API_BASE_URL=https://api.pretheeksha.com/api/v1
# PUBLIC_API_BASE_URL=https://api.pretheeksha.com/api/v1
# PUBLIC_BOOKING_APP_URL=https://booking.pretheeksha.com/

# Consent purpose code the lead form binds to (must match a published notice).
PUBLIC_LEAD_PURPOSE_CODE=marketing

# Fail-closed for CI/staging/production — missing required content fails the build.
CONTENT_FAIL_CLOSED=true

# Local-only escape hatch. Never enable in CI/staging/production.
ALLOW_CONTENT_FALLBACK=false

# Optional: remote bug-report ingest. Without it, reports stay in this browser only.
# PUBLIC_BUG_REPORT_API_URL=
