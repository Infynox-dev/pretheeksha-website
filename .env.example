# Server / build-time API base (never expose secrets here — these are public content URLs).
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Browser-facing API base (Astro inlines PUBLIC_* vars into shipped JS).
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Booking app the "Book Consultation" CTAs deep-link into.
PUBLIC_BOOKING_APP_URL=http://localhost:3000/

# Consent purpose code the lead form binds to (must match a published notice).
PUBLIC_LEAD_PURPOSE_CODE=marketing

# Canonical site URL (Astro `site` in astro.config.mjs). Optional locally.
# SITE_URL=https://pretheeksha.com

# Fail-closed for CI/staging/production builds — a missing required content
# endpoint MUST break the build so we never ship stale/empty pages by accident.
CONTENT_FAIL_CLOSED=true

# Local-only escape hatch. When true, a required content fetch failure falls
# back to `fixtures/content-fallback.json` instead of failing the build.
# Never enable in CI/production.
ALLOW_CONTENT_FALLBACK=false
